      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -928,
        480
      ],
      "webhookId": "4e0dc8fa-09b3-49f4-ba64-7ad7412fcb1c"
