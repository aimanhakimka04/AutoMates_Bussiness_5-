    {
      "parameters": {
        "jsCode": "const row = $input.first()?.json || {};\nif (!row?.leave_type_id) {\n  const lt = $('Parse Input').first()?.json?.leave_type || 'unknown';\n  return [{ json: { success: false, message: `Leave type not found: ${lt}`, data: null } }];\n}\nconst p = $('Parse Input').first().json;\nreturn [{ json: { employee_id: row.employee_id, leave_type_id: row.leave_type_id, status_id: row.status_id, start_date: p.start_date, end_date: p.end_date, total_days: p.total_days, reason: p.reason } }];"
