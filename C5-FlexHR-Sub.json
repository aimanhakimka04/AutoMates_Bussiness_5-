        "query": "SELECT \n    ea.attendance_id, \n    ea.clock_in_time, \n    ea.clock_in_latitude, \n    ea.clock_in_longitude, \n    ea.clock_out_time, \n    ea.clock_out_latitude, \n    ea.clock_out_longitude \nFROM employee_attendance ea\nJOIN employees e ON e.employee_id = ea.employee_id\nWHERE e.email = '{{ $json.user_email }}'\nORDER BY ea.clock_in_time DESC \nLIMIT 20",
        "options": {}
