      "parameters": {
        "jsCode": "const input  = $input.first().json;\nconst plan   = input.final_plan || input;\nconst params = plan.parameters  || {};\nconst data   = { ...params, ...plan };\nconst action = (plan.action || '').toLowerCase();\n\nconst clean = (v) => (!v || v === 'undefined' || v === 'null') ? '' : String(v).trim();\n\nreturn [{\n  json: {\n    action,\n    user_email:    clean(input.user_email)    || clean(plan.user_email),\n    user_name:     clean(input.user_name)     || clean(plan.user_name),\n    leave_type:    data.leave_type    || '',\n    start_date:    data.start_date    || '',\n    end_date:      data.end_date      || '',\n    total_days:    data.total_days    || 0,\n    reason:        data.reason        || '',\n    leave_id:      data.leave_id      || null,\n    attendance_id: data.attendance_id || null,\n    hours:         data.hours         || 0,\n    work_date:     data.work_date     || '',\n    employee_id:   input.employee_id  || null,\n    // Auth fields\n    email:         clean(data.email)        || clean(input.user_email),\n    password:      clean(data.password)     || '',\n    role:          clean(data.role)         || 'staff',\n    is_active:     data.is_active !== undefined ? data.is_active : true,\n    target_email:  clean(data.target_email) || '',\n    new_email:     clean(data.new_email)    || '',\n    name:          clean(data.name)         || clean(data.user_name) || '',\n  }\n}];"
      },
