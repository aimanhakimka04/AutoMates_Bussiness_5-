        "query": "SELECT \n    lt.leave_type_id, \n    sc.status_id \nFROM employees e\nCROSS JOIN leave_types lt\nCROSS JOIN status_codes sc\nWHERE e.employee_id = '{{ $json.employee_id }}'\nAND UPPER(lt.leave_type_name) ILIKE '%' || UPPER('{{ $json.leave_type }}') || '%'\nAND sc.status_code = 'PENDING'\nLIMIT 1;",
        "options": {}
      },
