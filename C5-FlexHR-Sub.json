    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT el.leave_id, lt.leave_type_name, el.start_date, el.end_date, el.total_days, el.reason, el.applied_at, sc.status_code, sc.status_description FROM employee_leaves el JOIN employees e ON e.employee_id = el.employee_id JOIN leave_types lt ON lt.leave_type_id = el.leave_type_id JOIN status_codes sc ON sc.status_id = el.status_id WHERE e.email = '{{ $json.user_email }}' ORDER BY el.applied_at DESC LIMIT 50",
        "options": {}
      },
