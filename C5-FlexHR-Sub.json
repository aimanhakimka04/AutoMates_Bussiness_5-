    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT lt.leave_type_name, COALESCE(SUM(el.total_days) FILTER (WHERE sc.status_code = 'APPROVED'), 0) AS used, CASE lt.leave_type_name WHEN 'Annual Leave' THEN 14 WHEN 'Sick Leave' THEN 14 WHEN 'Emergency Leave' THEN 3 WHEN 'Personal Leave' THEN 2 WHEN 'Maternity Leave' THEN 60 WHEN 'Paternity Leave' THEN 3 ELSE 0 END AS entitled FROM employees e CROSS JOIN leave_types lt LEFT JOIN employee_leaves el ON el.employee_id = e.employee_id AND el.leave_type_id = lt.leave_type_id AND el.start_date >= DATE_TRUNC('year', NOW()) LEFT JOIN status_codes sc ON sc.status_id = el.status_id WHERE e.email = '={{ $json.user_email }}' GROUP BY lt.leave_type_name",
        "options": {}
      },
      "id": "5a42d2dc-5cc9-430b-8232-171e26edb996",
      "name": "Query Balance",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1888,
        1904
      ],
      "credentials": {
        "postgres": {
          "id": "VA1zpzWg0o8f29xC",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.leave_type_name);\nconst bal = {};\nrows.forEach(r => { if (r.leave_type_name) bal[r.leave_type_name] = Math.max(0, Number(r.entitled) - Number(r.used)); });\nreturn [{ json: { success: true, data: bal } }];"
      },
      "id": "ad883228-039b-4ad3-a131-5934dccbe872",
