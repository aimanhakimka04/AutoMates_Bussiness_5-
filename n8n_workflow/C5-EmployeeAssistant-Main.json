      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items || items.length === 0) {\n  return [{ json: { error: 'Tiada data diterima', token_valid: false } }];\n}\n\n// Ambil header dengan selamat\nconst firstItem = items[0].json;\nconst authHeader = firstItem.headers?.authorization || firstItem.headers?.Authorization;\n\nif (!authHeader || !authHeader.startsWith('Bearer ')) {\n  return [{ json: { error: 'Missing or invalid Authorization header', token_valid: false } }];\n}\n\ntry {\n  const token = authHeader.substring(7);\n  const parts = token.split('.');\n  \n  if (parts.length !== 3) {\n    throw new Error('Format JWT tidak sah');\n  }\n\n  let payloadBase64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');\n  \n  // Tambah padding supaya format base64 sempurna\n  while (payloadBase64.length % 4 !== 0) {\n      payloadBase64 += '=';\n  }\n  \n  const payloadString = Buffer.from(payloadBase64, 'base64').toString('utf-8');\n  const decoded = JSON.parse(payloadString);\n\n  // Berjaya: Kembalikan data pekerja berserta flag token_valid = true\n  return [{\n    json: {\n      user_id: decoded.sub || 'user123',\n      email: decoded.upn || 'pekerja@chinhin.com',\n      roles: decoded.roles || ['employee'],\n      tenant_id: decoded.tenant_id || 'chinhin_hq',\n      token_valid: true\n    }\n  }];\n\n} catch (error) {\n  // Gagal: Kembalikan error berserta flag token_valid = false\n  return [{\n    json: {\n      error: error.message,\n      token_valid: false\n    }\n  }];\n}"
      },
