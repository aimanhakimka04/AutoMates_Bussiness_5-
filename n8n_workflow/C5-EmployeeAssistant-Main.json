    {
      "parameters": {
        "jsCode": "const incomingRequest = $('Webhook Trigger').item.json.body || {};\n// Ambil data dari node Parse JSON yang baru\nconst aiResponse = $('Code (Parse JSON)').item.json;\n\nlet final_plan;\n\n// Semak kalau pekerja dah tekan confirm di app\nif (incomingRequest.confirm === true && incomingRequest.edited_plan) {\n  final_plan = incomingRequest.edited_plan;\n} else {\n  // Kalau belum, gunakan pelan dari AI\n  final_plan = aiResponse.action_plan || {};\n}\n\n// Kembalikan data yang dah lengkap\nreturn [{\n  json: {\n    ...aiResponse,\n    final_plan: final_plan\n  }\n}];"
      },
