    {
      "parameters": {
        "jsCode": "let plan = $json.final_plan || {};\nlet params = plan.parameters || {};\n\n// Kalau AI dah bagi e-mel bilik, kita guna terus\nconst roomEmailProvided = params.room_email || params.roomEmail;\nif (roomEmailProvided) {\n  return [{ ...$json, room_email_resolved: roomEmailProvided }];\n}\n\n// Bersihkan nama bilik (huruf kecil & buang jarak berlebihan)\nconst roomName = (params.room_name || params.roomName || '').toString().toLowerCase().trim();\n\n// --- MOCK DIRECTORY UNTUK HACKATHON ---\n// Kat sini kita cipta e-mel olok-olok untuk bilik\nlet map = {\n  \"boardroom\": \"boardroom@company.com\", \n  \"meeting room a\": \"roomA@company.com\"\n};\n\n// Cari e-mel bilik. Kalau tak wujud dalam senarai, kita bagi e-mel default.\nconst resolved = map[roomName] || \"bilik_test@company.com\"; \n\nreturn [{ ...$json, room_email_resolved: resolved, room_name_normalized: roomName }];"
      },
      "id": "f74dd126-7a12-4ae6-8154-23f9ba9abbfe",
      "name": "Resolve Room Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
